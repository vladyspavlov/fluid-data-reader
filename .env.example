# Copy this file to .env and fill in the required values.
# All defaults are already set in docker-compose.yml — only secrets go here.

# Required: Base RPC endpoint (Alchemy, Infura, or any Base-compatible RPC)
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional: CoinGecko API key (used as fallback if DeFiLlama is down)
COINGECKO_API_KEY=
